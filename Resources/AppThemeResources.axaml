<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== FLUENT UI COLOR PALETTE ==================== -->
    <!-- Primary Colors -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryLightColor">#429CE3</Color>
    <Color x:Key="PrimaryDarkColor">#005A9E</Color>
    <Color x:Key="AccentColor">#0078D4</Color>

    <!-- ==================== LIGHT THEME COLORS ==================== -->
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="LightBackgroundSecondary">#F3F3F3</Color>
    <Color x:Key="LightBackgroundTertiary">#FAFAFA</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceVariant">#F5F5F5</Color>
    <Color x:Key="LightBorder">#E0E0E0</Color>
    <Color x:Key="LightBorderStrong">#D1D1D1</Color>
    
    <Color x:Key="LightTextPrimary">#1A1A1A</Color>
    <Color x:Key="LightTextSecondary">#616161</Color>
    <Color x:Key="LightTextTertiary">#9E9E9E</Color>
    <Color x:Key="LightTextOnPrimary">#FFFFFF</Color>
    
    <!-- Semantic Colors - Light -->
    <Color x:Key="LightSuccessColor">#107C10</Color>
    <Color x:Key="LightSuccessBackground">#DFF6DD</Color>
    <Color x:Key="LightWarningColor">#FF8C00</Color>
    <Color x:Key="LightWarningBackground">#FFF4CE</Color>
    <Color x:Key="LightDangerColor">#D13438</Color>
    <Color x:Key="LightDangerBackground">#FDE7E9</Color>
    <Color x:Key="LightInfoColor">#0078D4</Color>
    <Color x:Key="LightInfoBackground">#E1F3FB</Color>
    <Color x:Key="LightNeutralColor">#797979</Color>
    <Color x:Key="LightNeutralBackground">#F0F0F0</Color>

    <!-- Button Colors - Light -->
    <Color x:Key="LightButtonPrimaryBg">#0078D4</Color>
    <Color x:Key="LightButtonPrimaryHover">#006CBE</Color>
    <Color x:Key="LightButtonPrimaryPressed">#005A9E</Color>
    <Color x:Key="LightButtonSecondaryBg">#F3F3F3</Color>
    <Color x:Key="LightButtonSecondaryHover">#E5E5E5</Color>
    <Color x:Key="LightButtonSecondaryPressed">#D1D1D1</Color>
    <Color x:Key="LightButtonTextPrimary">#FFFFFF</Color>
    <Color x:Key="LightButtonTextSecondary">#1A1A1A</Color>

    <!-- ==================== DARK THEME COLORS ==================== -->
    <Color x:Key="DarkBackground">#1F1F1F</Color>
    <Color x:Key="DarkBackgroundSecondary">#2D2D2D</Color>
    <Color x:Key="DarkBackgroundTertiary">#383838</Color>
    <Color x:Key="DarkSurface">#252525</Color>
    <Color x:Key="DarkSurfaceVariant">#333333</Color>
    <Color x:Key="DarkBorder">#3D3D3D</Color>
    <Color x:Key="DarkBorderStrong">#4D4D4D</Color>
    
    <Color x:Key="DarkTextPrimary">#FFFFFF</Color>
    <Color x:Key="DarkTextSecondary">#B3B3B3</Color>
    <Color x:Key="DarkTextTertiary">#808080</Color>
    <Color x:Key="DarkTextOnPrimary">#FFFFFF</Color>
    
    <!-- Semantic Colors - Dark -->
    <Color x:Key="DarkSuccessColor">#6CCB5F</Color>
    <Color x:Key="DarkSuccessBackground">#1F3D1F</Color>
    <Color x:Key="DarkWarningColor">#FCE100</Color>
    <Color x:Key="DarkWarningBackground">#433D1F</Color>
    <Color x:Key="DarkDangerColor">#FF6B6B</Color>
    <Color x:Key="DarkDangerBackground">#3D1F1F</Color>
    <Color x:Key="DarkInfoColor">#60CDFF</Color>
    <Color x:Key="DarkInfoBackground">#1F3442</Color>
    <Color x:Key="DarkNeutralColor">#A0A0A0</Color>
    <Color x:Key="DarkNeutralBackground">#2D2D2D</Color>

    <!-- Button Colors - Dark -->
    <Color x:Key="DarkButtonPrimaryBg">#60CDFF</Color>
    <Color x:Key="DarkButtonPrimaryHover">#4DC3FF</Color>
    <Color x:Key="DarkButtonPrimaryPressed">#3BB8FF</Color>
    <Color x:Key="DarkButtonSecondaryBg">#3D3D3D</Color>
    <Color x:Key="DarkButtonSecondaryHover">#4D4D4D</Color>
    <Color x:Key="DarkButtonSecondaryPressed">#5D5D5D</Color>
    <Color x:Key="DarkButtonTextPrimary">#1A1A1A</Color>
    <Color x:Key="DarkButtonTextSecondary">#FFFFFF</Color>

    <!-- ==================== BRAND COLORS (Fluent UI) ==================== -->
    <Color x:Key="BrandBlue">#0078D4</Color>
    <Color x:Key="BrandBlueLight">#429CE3</Color>
    <Color x:Key="BrandBlueDark">#005A9E</Color>
    <Color x:Key="BrandPurple">#881798</Color>
    <Color x:Key="BrandTeal">#008272</Color>
    <Color x:Key="BrandGreen">#107C10</Color>
    <Color x:Key="BrandOrange">#FF8C00</Color>
    <Color x:Key="BrandRed">#D13438</Color>
    <Color x:Key="BrandMagenta">#B4009E</Color>

    <!-- ==================== NEUTRAL COLORS ==================== -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>
    
    <!-- Grayscale -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EBEBEB</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#C8C8C8</Color>
    <Color x:Key="Gray500">#A8A8A8</Color>
    <Color x:Key="Gray600">#767676</Color>
    <Color x:Key="Gray700">#616161</Color>
    <Color x:Key="Gray800">#404040</Color>
    <Color x:Key="Gray900">#2D2D2D</Color>

</ResourceDictionary>
